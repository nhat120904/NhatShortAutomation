editing_assets/facts_shorts_assets/733f46b6962d4299a3d81452/clipped_background.mp4"}, "25": {"_id": "c9961016a32d445a9edbffbb", "content_type": "reddit_shorts", "ready_to_upload": false, "last_completed_step": 10, "language": "English", "num_images": 5, "background_video_name": "Minecraft jumping circuit", "background_music_name": "blue yungkai", "script": "Reddit, What\u2019s the most unexpected thing you\u2019ve found in someone\u2019s fridge? I was over at this girl's house, you know, getting to know her a little better. So, I\u2019m in the kitchen, and I'm like, \"Hey, you got anything to drink?\" She opens the fridge, and I swear to God, right there on the top shelf is a jar of fingernails. Not even like a tiny jar, a freaking Mason jar, filled to the brim with cut, polished, and absolutely pristine fingernails. I was so stunned, I just stared. She noticed and laughed, saying, \"Oh, those? I keep them for art projects.\" I was like, \"Art projects?!\" She shrugged and closed the fridge, but I couldn\u2019t get over it. It was the weirdest first date fridge moment ever.", "reddit_question": "What\u2019s the most unexpected thing you\u2019ve found in someone\u2019s fridge", "temp_audio_path": ".editing_assets/reddit_shorts_assets/c9961016a32d445a9edbffbb/temp_audio_path.wav", "audio_path": ".editing_assets/reddit_shorts_assets/c9961016a32d445a9edbffbb/audio_voice.wav", "timed_captions": [[[0.18, 0.9], "Reddit, what's"], [[0.9, 1.14], "the most"], [[1.14, 1.74], "unexpected"], [[1.74, 2.46], "thing you found"], [[2.46, 3.1], "in someone's"], [[3.1, 4.68], "fridge? I was"], [[4.68, 5.22], "over at this"], [[5.22, 5.6], "girl's"], [[5.6, 6.1], "house, you"], [[6.1, 6.72], "know, getting"], [[6.72, 7.44], "to know her a"], [[7.44, 7.62], "little"], [[7.62, 7.94], "better."], [[8.98, 9.72], "So, I'm in the"], [[9.72, 10.3], "kitchen, and"], [[10.3, 10.6], "unlike,"], [[10.88, 11.48], "hey, you got"], [[11.48, 12.02], "anything to"], [[12.02, 13.5], "drink. She"], [[13