fps.mp4"], [[16.72, 20.48], "https://videos.pexels.com/video-files/7235867/7235867-hd_1920_1080_30fps.mp4"], [[20.48, 24.34], "https://videos.pexels.com/video-files/854417/854417-hd_1920_1080_25fps.mp4"], [[24.34, 28.48], "https://videos.pexels.com/video-files/8618456/8618456-hd_1920_1080_30fps.mp4"], [[28.48, 32.06], "https://videos.pexels.com/video-files/856309/856309-hd_1920_1080_30fps.mp4"], [[32.06, 36.7], "https://videos.pexels.com/video-files/7895836/7895836-hd_1920_1080_30fps.mp4"], [[36.7, 38.0], "https://videos.pexels.com/video-files/8044791/8044791-hd_1920_1080_25fps.mp4"]], "background_music_url": "public/Music dj quads.wav", "voiceover_duration": 39.0, "video_path": "videos/2025-05-13_08-58-02 - Stay Motivated Small Steps Lead to Big Wins .mp4", "yt_title": "Stay Motivated: Small Steps Lead to Big Wins \ud83d\ude80", "yt_description": "Discover how setting small goals can boost your motivation and lead to success. #motivation #goals #positivity"}, "15": {"_id": "40dd4bb8ae054a56a8714a98", "content_type": "general_video", "ready_to_upload": true, "last_completed_step": 10, "language": "English", "auto_music": false, "background_music_name": "", "script": "In the journey of life, motivation is the spark that keeps us moving forward. It\u2019s what pushes us to chase our dreams, no matter the obstacles. But sometimes, that spark can fade. When you feel the fire dimming, remember why you started. Reflect on the moments that ignited your passion in the first place. Surround yourself with people who believe in you and inspire you to be your best. Small steps can lead to big changes, so don\u2019t underestimate the power of progress, no matter how small. Every goal is just a series of small wins. Keep your eyes on the prize, but enjoy the journey, too. You\u2019ve got this. Your potential is limitless, and your story is far from over.", "format_vertical": false, "temp_audio_path": ".editing_assets/general_video_assets/40dd4bb8ae054a56a8714a98/temp_audio_path.w